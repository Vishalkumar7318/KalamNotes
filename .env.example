# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a free key at https://aistudio.google.com/apikey
# For LOCAL use: copy this file to .env.local and put your real key there.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: comma-separated model list, tried in order (defaults are set in server.ts)
# GEMINI_MODELS="gemini-flash-lite-latest,gemini-flash-latest,gemini-3.5-flash-lite"

# Optional: per-model timeout in milliseconds (default 120000)
# GEMINI_TIMEOUT_MS=120000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
